{
 "_comment": "The public synth engine .plg set of poly-engines-os: one row per engine. Sources are relative to src/synth-open/ (their tracker-ff path synth-open/). opt: engines = the flavour's OpenTracker module flags, o3 = the flavour's FM4 / B-Type flags, anything else = literal flags. extra = more flags of the DSP source only. name = the descriptor name (-DSYNTH_ENGINE_<name>). stored, patch, type = the numbers of the engine (plug_abi.h PLUG_SYNTH_MANIFEST), they must equal the row of the same id in tracker-ff engines/engines.json (tracker-ff engines/crosscheck.sh and build_set.py verify-external check the built files against it). version = the .plg header version, bump it when that engine's bytes change on purpose. licence, licence_files, notice: what ships next to the .wasm (notices = the texts).",
 "set_version": "1.0.0",
 "default_flavour": "autof",
 "flavours": {
  "autof": {
   "engines": "-O2 -ffp-contract=off",
   "o3": "-O3 -ffp-contract=off",
   "note": "1.2.0 release: -ffp-contract=off on every engine (AUTO-F)"
  },
  "fused": {
   "engines": "-O2",
   "o3": "-O3",
   "note": "compiler default fp contraction, the unpublished AUTO fallback"
  }
 },
